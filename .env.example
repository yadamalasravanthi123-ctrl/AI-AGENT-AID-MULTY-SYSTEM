# ── IBM watsonx.ai credentials ─────────────────────────────────────────────
# Obtain from: https://cloud.ibm.com → watsonx.ai project → Manage → API keys

# Your IBM Cloud API key
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Your watsonx.ai project ID (found in project Settings → General)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai service URL (default: us-south)
# Options: https://us-south.ml.cloud.ibm.com
#          https://eu-de.ml.cloud.ibm.com
#          https://eu-gb.ml.cloud.ibm.com
#          https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model to use (default: granite-13b-chat-v2)
# Options: ibm/granite-13b-chat-v2
#          ibm/granite-3-8b-instruct
#          ibm/granite-20b-multilingual
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# ── Flask settings ──────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=true
